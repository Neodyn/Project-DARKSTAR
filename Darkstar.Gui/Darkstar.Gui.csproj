<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Darkstar.Gui</RootNamespace>
    <AssemblyName>Darkstar.ConfigEditor</AssemblyName>
    <AssemblyTitle>D.A.R.K.S.T.A.R. Config Editor</AssemblyTitle>

    <!--
      Same reasoning as in Darkstar.csproj, and it matters more here: the Blazor WebView package
      brings a localized resource DLL per language for the ASP.NET Core components, and every one
      of those languages would be installed alongside a UI whose labels are hardcoded English.
      See docs\building-the-installer.md.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosts Blazor (Razor components) inside a native WPF window via WebView2 - lets us reuse
         plain HTML/CSS for styling (close to the original mockup) while still being a normal
         Windows desktop app, and lets Razor components call straight into Darkstar.Core
         (AppConfig, PhraseBook, VocabularyBook) with no serialization boundary in between.
         NOTE: no explicit Microsoft.Web.WebView2 reference here on purpose - let this package
         pull in whichever WebView2 version it was actually built against, instead of pinning a
         version ourselves and risking a mismatch. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.100" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Darkstar.Core\Darkstar.Core.csproj" />
  </ItemGroup>

</Project>
