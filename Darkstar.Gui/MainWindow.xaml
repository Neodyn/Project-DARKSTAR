<Window x:Class="Darkstar.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:Darkstar.Gui"
        Title="D.A.R.K.S.T.A.R. Config Editor"
        Height="780" Width="1180" MinHeight="600" MinWidth="900"
        Background="#0E1417">
    <Grid>
        <blazor:BlazorWebView x:Name="BlazorView"
                               HostPage="wwwroot\index.html"
                               Services="{DynamicResource services}">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:Main}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
