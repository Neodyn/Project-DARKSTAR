@namespace Darkstar.Gui.Pages
@using Microsoft.JSInterop
@inject ConfigStore Store
@inject IJSRuntime JS
@implements IDisposable

@if (Section == SectionServer)
{
<h1>DCS-gRPC — SERVER &amp; TEST</h1>
<p style="color:#8CA0A8;font-size:11.5px;margin-top:-8px;margin-bottom:16px">
    The connection to the running mission. Everything the bot knows about the world comes through
    here: bogey dope, picture, threat check, alpha check, friendly positions, the threat circle,
    runway in use and ATIS, the generated tower frequencies and their F10 markers. Switch it off and
    all of that falls back to phrases.json and Gemini. Test it here, then set up the replies and the
    mission explorer from the two entries beside this one.
</p>

<div class="toggle-row">
    <span>Enable DCS-gRPC</span>
    <button class="toggle @(Store.Config.DcsGrpcEnabled ? "on" : "")" @onclick="() => Store.Config.DcsGrpcEnabled = !Store.Config.DcsGrpcEnabled">
        <span class="knob"></span>
    </button>
</div>

<div class="field" style="opacity:@(Store.Config.DcsGrpcEnabled ? "1" : "0.5")">
    <label>SERVER ADDRESS</label>
    <input type="text" @bind="Store.Config.DcsGrpcAddress" placeholder="http://127.0.0.1:50051" disabled="@(!Store.Config.DcsGrpcEnabled)" />
</div>

<div class="field" style="opacity:@(Store.Config.DcsGrpcEnabled ? "1" : "0.5")">
    <label>API KEY (only if auth is enabled on the server)</label>
    <input type="password" @bind="Store.Config.DcsGrpcApiKey" disabled="@(!Store.Config.DcsGrpcEnabled)" />
</div>

<button class="link-action" @onclick="RunTest" disabled="@(_testing || !Store.Config.DcsGrpcEnabled)">
    <span>@(_testing ? "Testing..." : "Test connection")</span>
</button>

@if (_result != null)
{
    <div class="card" style="border-color:@(_result.Success ? "#2E4E4C" : "#6C2E2E");margin-top:8px">
        <div style="display:flex;align-items:center;gap:10px">
            <span style="color:@(_result.Success ? "#5FBF7A" : "#E2543A");font-size:14px">@(_result.Success ? "✓" : "✕")</span>
            <span style="font-size:12.5px;color:#E7EDEF">@(_result.Success ? "Connection OK" : "Connection failed")</span>
        </div>
        <div style="font-size:12px;color:#8CA0A8;margin-top:8px">@_result.Message</div>
    </div>
}
}

@if (Section == SectionReplies)
{
<!-- ================= Tactical replies (bogey dope / picture / threat) ================= -->

<h1>REPLIES FROM MISSION DATA</h1>
<p style="color:#8CA0A8;font-size:11.5px;margin-top:-8px;margin-bottom:16px">
    Everything the bot answers from the running mission instead of from phrases.json or Gemini, in
    the order the cards appear: bogey dope, picture, threat check and alpha check, then friendly
    positions, the threat circle, a test button that shows a reply without transmitting, and the
    airfield calls — runway in use and ATIS.
</p>

<div class="toggle-row">
    <span>Answer tactical requests from mission data</span>
    <button class="toggle @(Store.Config.DcsIntelEnabled ? "on" : "")" @onclick="() => Store.Config.DcsIntelEnabled = !Store.Config.DcsIntelEnabled">
        <span class="knob"></span>
    </button>
</div>

@if (Store.Config.DcsIntelEnabled && !Store.Config.DcsGrpcEnabled)
{
    <div class="card" style="border-color:#6C2E2E;font-size:12px;color:#F2A93B">
        DCS-gRPC is switched off under SERVER &amp; TEST - tactical requests will keep being handled by phrases/Gemini.
    </div>
}

<div style="opacity:@(Store.Config.DcsIntelEnabled ? "1" : "0.5")">
    <div class="field">
        <label>CONTACT SOURCE</label>
        <select @bind="Store.Config.DcsIntelContactSource" disabled="@(!Store.Config.DcsIntelEnabled)">
            <option value="AwacsThenMissionData">AWACS sensors, mission data as fallback</option>
            <option value="AwacsOnly">AWACS sensors only — no god's eye</option>
            <option value="MissionDataOnly">Mission data only (god's eye)</option>
        </select>
        <div class="hint">
            @switch (Store.Config.DcsIntelContactSource)
            {
                case "AwacsOnly":
                    <span>
                        Strictly what the unit below detects; "detects nothing" is reported as a clean picture.
                        <b>DCS only fills the detection table for AI units</b>, so a player-flown AWACS will always
                        look blind in this mode. Without a unit name, tactical requests answer "no tactical data".
                    </span>
                    break;
                case "MissionDataOnly":
                    <span>Every hostile aircraft in the mission is reported, whether detected or not. The unit name below is ignored.</span>
                    break;
                default:
                    <span>
                        Uses the unit's sensors when they deliver contacts, and plain mission data whenever they
                        don't (empty detection table, unit missing, call failed). Never falsely reports a clean
                        picture — but gives god's-eye information while the AWACS sees nothing.
                    </span>
                    break;
            }
        </div>
    </div>

    <div class="field" style="opacity:@(Store.Config.DcsIntelContactSource == "MissionDataOnly" ? "0.5" : "1")">
        <label>AWACS UNIT NAME (mission editor name)</label>
        <input type="text" list="grpc-names" @bind="Store.Config.DcsIntelAwacsUnitName"
               placeholder="@(Store.Config.DcsIntelContactSource == "AwacsOnly" ? "(required in this mode)" : "(empty = report every hostile aircraft, god's eye)")"
               disabled="@(!Store.Config.DcsIntelEnabled || Store.Config.DcsIntelContactSource == "MissionDataOnly")" />
        <div class="hint">Only contacts this unit's group actually detects are reported. Use an <b>AI</b> AWACS.</div>
    </div>

    @if (Store.Config.DcsIntelContactSource == "AwacsOnly" && string.IsNullOrWhiteSpace(Store.Config.DcsIntelAwacsUnitName))
    {
        <div class="card" style="border-color:#6C2E2E;font-size:12px;color:#F2A93B">
            No unit named, and mission data is switched off — tactical requests will answer "no tactical data".
        </div>
    }

    <div class="row3">
        <div class="field">
            <label>MAX RANGE (NM, 0 = NO LIMIT)</label>
            <input type="number" step="10" min="0" @bind="Store.Config.DcsIntelMaxRangeNm" disabled="@(!Store.Config.DcsIntelEnabled)" />
        </div>
        <div class="field">
            <label>GROUPS PER PICTURE</label>
            <input type="number" min="1" max="6" @bind="Store.Config.DcsIntelMaxGroups" disabled="@(!Store.Config.DcsIntelEnabled)" />
        </div>
        <div class="field">
            <label>QUERY TIMEOUT (SECONDS)</label>
            <input type="number" min="1" max="30" @bind="Store.Config.DcsIntelTimeoutSeconds" disabled="@(!Store.Config.DcsIntelEnabled)" />
        </div>
    </div>

    <div class="row3">
        <div class="toggle-row">
            <span style="font-size:12px">Magnetic bearings</span>
            <button class="toggle @(Store.Config.DcsIntelMagneticBearings ? "on" : "")" disabled="@(!Store.Config.DcsIntelEnabled)"
                    @onclick="() => Store.Config.DcsIntelMagneticBearings = !Store.Config.DcsIntelMagneticBearings">
                <span class="knob"></span>
            </button>
        </div>
        <div class="toggle-row">
            <span style="font-size:12px">Include helicopters</span>
            <button class="toggle @(Store.Config.DcsIntelIncludeHelicopters ? "on" : "")" disabled="@(!Store.Config.DcsIntelEnabled)"
                    @onclick="() => Store.Config.DcsIntelIncludeHelicopters = !Store.Config.DcsIntelIncludeHelicopters">
                <span class="knob"></span>
            </button>
        </div>
        <div class="toggle-row">
            <span style="font-size:12px">Say aircraft type</span>
            <button class="toggle @(Store.Config.DcsIntelSayContactType ? "on" : "")" disabled="@(!Store.Config.DcsIntelEnabled)"
                    @onclick="() => Store.Config.DcsIntelSayContactType = !Store.Config.DcsIntelSayContactType">
                <span class="knob"></span>
            </button>
        </div>
    </div>

    <div class="toggle-row">
        <div>
            <div>Slow, clearly spoken numbers</div>
            <div style="font-size:11px;color:#5A6A70;margin-top:3px">
                Comma between the digits of a bearing, and ranges/altitudes/counts spelled out as words -
                so TTS doesn't rattle through them.
            </div>
        </div>
        <button class="toggle @(Store.Config.DcsIntelSlowSpeech ? "on" : "")" disabled="@(!Store.Config.DcsIntelEnabled)"
                @onclick="() => Store.Config.DcsIntelSlowSpeech = !Store.Config.DcsIntelSlowSpeech">
            <span class="knob"></span>
        </button>
    </div>

    <div class="row2">
        <div class="field">
            <label>BOGEY DOPE TRIGGERS (comma separated)</label>
            <input type="text" @bind="BogeyDopeTriggers" disabled="@(!Store.Config.DcsIntelEnabled)" />
        </div>
        <div class="field">
            <label>BULLSEYE TRIGGERS</label>
            <input type="text" @bind="BullseyeTriggers" disabled="@(!Store.Config.DcsIntelEnabled)" />
            <div class="hint">
                Not a request of its own: a word a pilot adds to one — "bogey dope bullseye" — to get
                the answer from the bullseye instead of from their own aircraft.
            </div>
        </div>
    </div>
    <div class="row2">
        <div class="field">
            <label>PICTURE TRIGGERS</label>
            <input type="text" @bind="PictureTriggers" disabled="@(!Store.Config.DcsIntelEnabled)" />
        </div>
        <div class="field">
            <label>THREAT TRIGGERS</label>
            <input type="text" @bind="ThreatTriggers" disabled="@(!Store.Config.DcsIntelEnabled)" />
        </div>
    </div>

    <div class="row2">
        <div class="field">
            <label>ALPHA CHECK TRIGGERS</label>
            <input type="text" @bind="AlphaCheckTriggers" disabled="@(!Store.Config.DcsIntelEnabled)" />
            <div class="hint">
                "Overlord, Punch 1-1, alpha check bullseye." Answers the caller's own position as a
                bearing, range and altitude from the bullseye — how a pilot confirms their navigation
                still agrees with everyone else's.
            </div>
        </div>
        <div class="field">
            <label>REPLY WHEN THE CALLER CANNOT BE FOUND</label>
            <input type="text" @bind="Store.Config.DcsIntelNoPositionReply" disabled="@(!Store.Config.DcsIntelEnabled)" />
            <div class="hint">
                Used for an alpha check when the SRS name cannot be matched to a unit in the mission —
                usually a name mismatch rather than a missing aircraft.
            </div>
        </div>
    </div>

    <div class="row2">
        <div class="field">
            <label>REPLY WHEN NOTHING IS FOUND</label>
            <input type="text" @bind="Store.Config.DcsIntelNoContactsReply" disabled="@(!Store.Config.DcsIntelEnabled)" />
        </div>
        <div class="field">
            <label>REPLY WHEN MISSION DATA IS UNAVAILABLE</label>
            <input type="text" @bind="Store.Config.DcsIntelUnavailableReply" disabled="@(!Store.Config.DcsIntelEnabled)" />
        </div>
    </div>

    <div class="card">
        <div class="card-head" style="margin-bottom:6px">
            <span style="font-size:12.5px;color:#E7EDEF">Friendly positions ("where is Springfield 2-1?")</span>
            <span class="spacer"></span>
            <button class="toggle @(Store.Config.DcsIntelFriendlyPositionEnabled ? "on" : "")" disabled="@(!Store.Config.DcsIntelEnabled)"
                    @onclick="() => Store.Config.DcsIntelFriendlyPositionEnabled = !Store.Config.DcsIntelFriendlyPositionEnabled">
                <span class="knob"></span>
            </button>
        </div>

        <div class="card" style="border-color:#6C5A2E;background:#241F12;margin:8px 0">
            <div style="font-size:11.5px;color:#F2A93B">
                <strong>Off by default, and that is a decision about your server rather than a setting.</strong>
                A bot that reads out any player's position on request changes how a PvP server plays. Only
                <em>human players on the caller's own side</em> are ever reported, and a caller whose coalition
                cannot be determined from the SRS client list — a spectator, for instance — is refused outright.
                Assign it to specific frequencies on CH2 if you want it on a squadron channel only.
            </div>
        </div>

        <div class="field">
            <label>TRIGGERS (comma separated)</label>
            <input type="text" @bind="FriendlyPositionTriggers" disabled="@FriendlyDisabled" />
            <div class="hint">
                Whatever follows the phrase is taken as the aircraft being asked about, so these belong at
                the front of a name: "where is <em>Springfield 2-1</em>". That is how a transmission naming
                two pilots — the caller and the target — stays answerable at all.
            </div>
        </div>

        <div class="row2">
            <div class="field">
                <label>REPLY WHEN THE NAMED PILOT ISN'T FOUND</label>
                <input type="text" @bind="Store.Config.DcsIntelFriendlyNotFoundReply" disabled="@FriendlyDisabled" />
                <div class="hint"><code>{pilot}</code> is replaced with the name as it was said. Repeating it
                back is what tells the caller it was a name problem, not a missing aircraft.</div>
            </div>
            <div class="field">
                <label>REPLY WHEN NOBODY WAS NAMED</label>
                <input type="text" @bind="Store.Config.DcsIntelFriendlyNoNameReply" disabled="@FriendlyDisabled" />
                <div class="hint">For "Overlord, where is he?" — a different situation from a name that can't be found.</div>
            </div>
        </div>

        <div class="field">
            <label>REPLY WHEN THE CALLER'S COALITION IS UNKNOWN</label>
            <input type="text" @bind="Store.Config.DcsIntelFriendlyNoCoalitionReply" disabled="@FriendlyDisabled" />
        </div>

        <div class="toggle-row">
            <div>
                <div>Also say the friendly's heading</div>
                <div style="font-size:11px;color:#5A6A70;margin-top:3px">
                    Where they are is only half of a rejoin. Aspect is deliberately never given — that
                    describes a contact closing on you, which is a question about an enemy.
                </div>
            </div>
            <button class="toggle @(Store.Config.DcsIntelFriendlySayHeading ? "on" : "")" disabled="@FriendlyDisabled"
                    @onclick="() => Store.Config.DcsIntelFriendlySayHeading = !Store.Config.DcsIntelFriendlySayHeading">
                <span class="knob"></span>
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-head" style="margin-bottom:6px">
            <span style="font-size:12.5px;color:#E7EDEF">Threat circle (standing watch)</span>
            <span class="spacer"></span>
            <button class="toggle @(Store.Config.DcsIntelThreatCircleEnabled ? "on" : "")" disabled="@(!Store.Config.DcsIntelEnabled)"
                    @onclick="() => Store.Config.DcsIntelThreatCircleEnabled = !Store.Config.DcsIntelThreatCircleEnabled">
                <span class="knob"></span>
            </button>
        </div>
        <div style="font-size:11.5px;color:#8CA0A8;margin-bottom:12px">
            A pilot asks for "threat circle forty miles" and the bot keeps watching a circle of that
            radius <b>around their own aircraft</b> — it moves with them — warning them on this
            frequency as soon as a hostile aircraft or helicopter enters it. Every contact is
            reported once per circle.
        </div>

        <div style="opacity:@(Store.Config.DcsIntelThreatCircleEnabled && Store.Config.DcsIntelEnabled ? "1" : "0.5")">
            <div class="row3">
                <div class="field">
                    <label>DEFAULT RADIUS (NM)</label>
                    <input type="number" step="5" min="1" @bind="Store.Config.DcsIntelThreatCircleDefaultRadiusNm" disabled="@ThreatCircleDisabled" />
                    <div class="hint">Used when the pilot names no radius.</div>
                </div>
                <div class="field">
                    <label>MAX RADIUS (NM)</label>
                    <input type="number" step="10" min="1" @bind="Store.Config.DcsIntelThreatCircleMaxRadiusNm" disabled="@ThreatCircleDisabled" />
                </div>
                <div class="field">
                    <label>SWEEP INTERVAL (SECONDS)</label>
                    <input type="number" min="5" max="300" @bind="Store.Config.DcsIntelThreatCirclePollSeconds" disabled="@ThreatCircleDisabled" />
                    <div class="hint">One set of mission queries per circle and sweep.</div>
                </div>
            </div>

            <div class="row3">
                <div class="field">
                    <label>EXPIRES AFTER (MINUTES)</label>
                    <input type="number" min="1" @bind="Store.Config.DcsIntelThreatCircleDurationMinutes" disabled="@ThreatCircleDisabled" />
                </div>
                <div class="field">
                    <label>MAX CIRCLES AT ONCE</label>
                    <input type="number" min="1" max="32" @bind="Store.Config.DcsIntelThreatCircleMaxActive" disabled="@ThreatCircleDisabled" />
                </div>
                <div class="field">
                    <label>MAX WARNINGS PER SWEEP</label>
                    <input type="number" min="1" max="10" @bind="Store.Config.DcsIntelThreatCircleMaxAlertsPerSweep" disabled="@ThreatCircleDisabled" />
                    <div class="hint">The rest follow on later sweeps.</div>
                </div>
            </div>

            <div class="row2">
                <div class="field">
                    <label>START TRIGGERS</label>
                    <input type="text" @bind="ThreatCircleTriggers" disabled="@ThreatCircleDisabled" />
                </div>
                <div class="field">
                    <label>CANCEL TRIGGERS</label>
                    <input type="text" @bind="ThreatCircleCancelTriggers" disabled="@ThreatCircleDisabled" />
                </div>
            </div>

            <div class="row2">
                <div class="field">
                    <label>REPLY WHEN THE CIRCLE WAS CANCELLED</label>
                    <input type="text" @bind="Store.Config.DcsIntelThreatCircleCancelledReply" disabled="@ThreatCircleDisabled" />
                </div>
                <div class="field">
                    <label>REPLY WHEN NOTHING WAS RUNNING</label>
                    <input type="text" @bind="Store.Config.DcsIntelThreatCircleNoneActiveReply" disabled="@ThreatCircleDisabled" />
                    <div class="hint">A cancel call from a pilot who has no circle armed.</div>
                </div>
            </div>

            <div class="row2">
                <div class="field">
                    <label>REPLY WHEN THE CALLER'S AIRCRAFT WASN'T FOUND</label>
                    <input type="text" @bind="Store.Config.DcsIntelThreatCircleNoPilotReply" disabled="@ThreatCircleDisabled" />
                    <div class="hint">
                        A circle is centred on the caller's aircraft, so without it there is nothing to
                        centre on — same name-matching problem as a BRAA call.
                    </div>
                </div>
                <div class="field">
                    <label>REPLY WHEN TOO MANY CIRCLES ARE ACTIVE</label>
                    <input type="text" @bind="Store.Config.DcsIntelThreatCircleBusyReply" disabled="@ThreatCircleDisabled" />
                    <div class="hint">Said rather than silently ignoring the request.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-head" style="margin-bottom:8px">
            <span style="font-size:12.5px;color:#E7EDEF">Try it without flying</span>
        </div>
        <div class="row3">
            <div class="field">
                <label>REQUEST</label>
                <select @bind="_intelKind" disabled="@(!Store.Config.DcsIntelEnabled)">
                    <option value="BogeyDope">Bogey dope</option>
                    <option value="Picture">Picture</option>
                    <option value="Threat">Threat check</option>
                </select>
            </div>
            <div class="field">
                <label>PILOT'S SRS NAME (for BRAA)</label>
                <input type="text" @bind="_intelPlayerName" placeholder="(empty = bullseye reference)" disabled="@(!Store.Config.DcsIntelEnabled)" />
            </div>
            <div class="field">
                <label>&nbsp;</label>
                <button class="link-action" style="margin:0;padding-top:8px" @onclick="RunIntelTest" disabled="@(_intelTesting || !Store.Config.DcsIntelEnabled)">
                    <span>@(_intelTesting ? "Asking..." : "Show reply")</span>
                </button>
            </div>
        </div>
        <div class="hint" style="font-size:11px">
            Uses the settings as currently shown here (no need to save first) and only displays the
            reply - nothing is transmitted on SRS.
        </div>
        @if (_intelResult != null)
        {
            <div class="log-tail" style="margin-top:10px;user-select:text">@_intelResult</div>
        }
    </div>

    <!-- ---------------- Airfield: runway in use and ATIS ---------------- -->

    <div class="card">
        <div class="toggle-row" style="margin:0 0 4px 0">
            <div>
                <div>Answer "runway in use" and ATIS calls</div>
                <div style="font-size:11px;color:#5A6A70;margin-top:3px">
                    Live wind, temperature and pressure, plus the runway the wind actually favours.
                </div>
            </div>
            <button class="toggle @(Store.Config.DcsAirfieldEnabled ? "on" : "")" @onclick="() => Store.Config.DcsAirfieldEnabled = !Store.Config.DcsAirfieldEnabled">
                <span class="knob"></span>
            </button>
        </div>

        @if (Store.Config.DcsAirfieldEnabled)
        {
            <div class="card" style="border-color:#6C5A2E;background:#241F12;margin:8px 0">
                <div style="font-size:11.5px;color:#D9A62E;font-weight:600;margin-bottom:4px">
                    Needs one setting on the DCS-gRPC server
                </div>
                <div style="font-size:11px;color:#8CA0A8">
                    Runway headings come from <code>Airbase.getRunways()</code>, which DCS-gRPC only exposes
                    through its <code>Eval</code> method — and that is <strong>disabled by default</strong>.
                    Set <code>evalEnabled = true</code> in the DCS-gRPC server configuration and restart the
                    mission. Without it the weather still works and the runway is reported as unknown.
                    <br /><br />
                    The bot runs exactly one fixed, read-only Lua snippet (built into the code, nothing a pilot
                    says ever reaches it) and caches the result for the whole mission.
                    <br /><br />
                    Taxiways are not available at all — DCS doesn't expose them, through gRPC or otherwise.
                </div>
            </div>

            <div class="row2">
                <div class="field">
                    <label>RUNWAY TRIGGERS</label>
                    <input type="text" @bind="AirfieldRunwayTriggers" />
                    <div class="hint">Comma-separated. Asks for the runway only.</div>
                </div>
                <div class="field">
                    <label>ATIS TRIGGERS</label>
                    <input type="text" @bind="AirfieldAtisTriggers" />
                    <div class="hint">Checked first — the fuller answer wins.</div>
                </div>
            </div>

            <div class="field" style="max-width:460px">
                <label>ALTIMETER SETTING</label>
                <div class="row3">
                    @foreach (var unit in new[] { PressureUnit.Both, PressureUnit.Hectopascals, PressureUnit.InchesHg })
                    {
                        var selected = Store.Config.DcsAirfieldPressureUnit == unit;
                        var label = unit switch
                        {
                            PressureUnit.Hectopascals => "QNH (hPa)",
                            PressureUnit.InchesHg => "inHg",
                            _ => "Both"
                        };
                        <button class="link-action"
                                style="justify-content:center;border:1px solid @(selected ? "#2E4E4C" : "#2A363C");border-radius:4px;padding:8px;color:@(selected ? "#5FBF7A" : "#5A6A70");background:@(selected ? "#16302A" : "transparent")"
                                @onclick="() => Store.Config.DcsAirfieldPressureUnit = unit">@label</button>
                    }
                </div>
                <div class="hint"><strong>Both</strong> reads QNH in hectopascals and then the inches setting — for a mixed flight of western and eastern types.</div>
            </div>

            <div class="row2">
                <div class="field">
                    <label>"AT THE FIELD" RADIUS (NM)</label>
                    <input type="number" step="0.5" min="0.5" @bind="Store.Config.DcsAirfieldAtFieldNm" />
                    <div class="hint">
                        Inside this, the pilot's own position decides the airfield — even if the
                        transcript looked like it named a different one. This is what makes
                        <em>"active runway for Punch 1-1"</em> work from the ramp without anyone having
                        to pronounce the airfield well enough for speech recognition.
                    </div>
                </div>
                <div class="field">
                    <label>MAXIMUM DISTANCE (NM)</label>
                    <input type="number" step="5" min="5" @bind="Store.Config.DcsAirfieldMaxDistanceNm" />
                    <div class="hint">
                        Beyond this the bot asks which airfield rather than naming one far away as
                        though the pilot were there.
                    </div>
                </div>
            </div>

            <div class="row2">
                <div class="field">
                    <label>REPLY WHEN NO AIRFIELD COULD BE DETERMINED</label>
                    <input type="text" @bind="Store.Config.DcsAirfieldUnknownReply" />
                </div>
                <div class="field">
                    <label>REPLY WHEN NO DATA IS AVAILABLE</label>
                    <input type="text" @bind="Store.Config.DcsAirfieldUnavailableReply" />
                </div>
            </div>

            <div class="row3">
                <div class="field">
                    <label>REQUEST</label>
                    <select @bind="_airfieldKind">
                        <option value="RunwayInUse">Runway in use</option>
                        <option value="Atis">ATIS</option>
                    </select>
                </div>
                <div class="field">
                    <label>AIRFIELD (OR PILOT'S SRS NAME)</label>
                    <input type="text" @bind="_airfieldQuery" placeholder="e.g. Batumi" />
                </div>
                <div class="field">
                    <label>&nbsp;</label>
                    <button class="link-action" style="margin:0;padding-top:8px" @onclick="RunAirfieldTest" disabled="@_airfieldTesting">
                        <span>@(_airfieldTesting ? "Asking..." : "Show reply")</span>
                    </button>
                </div>
            </div>
            <div class="hint" style="font-size:11px">
                Naming an airfield asks about that one; leaving it empty and entering a pilot's SRS name
                instead asks about the airfield nearest them. Nothing is transmitted on SRS.
            </div>
            @if (_airfieldResult != null)
            {
                <div class="log-tail" style="margin-top:10px;user-select:text">@_airfieldResult</div>
            }
        }
    </div>
</div>
}

@if (Section == SectionExplorer)
{
<!-- ================= Mission data explorer ================= -->

<h1>MISSION DATA EXPLORER</h1>
<p style="color:#8CA0A8;font-size:11.5px;margin-top:-8px;margin-bottom:16px">
    Read-only: only Get/Stream calls are made - nothing in the running mission is changed.
    Results are shown as the raw JSON DCS-gRPC returns (all fields, including empty/default values).
</p>

@if (!Store.Config.DcsGrpcEnabled)
{
    <div class="card" style="color:#8CA0A8;font-size:12px">Enable DCS-gRPC under SERVER &amp; TEST to use the explorer.</div>
}
else
{
    <div class="card">
        <div class="card-head">
            <span style="font-size:12.5px;color:#E7EDEF">Mission snapshot</span>
            <span class="spacer"></span>
            <button class="link-action" style="margin:0" @onclick="RunSnapshot" disabled="@_running">
                <span>@(_running && _runningSnapshot ? "Collecting..." : "Run snapshot")</span>
            </button>
        </div>
        <div style="font-size:11.5px;color:#8CA0A8">
            Runs every query that needs no input (mission, time, theatre, airbases, groups, player units,
            statics, players, bullseye of both sides...) in one go - the quickest overview of what's available.
        </div>
    </div>

    <div class="card">
        <div class="field">
            <label>SINGLE QUERY</label>
            <select @bind="_queryId">
                @foreach (var group in DcsGrpcExplorer.Queries.GroupBy(q => q.Category))
                {
                    <optgroup label="@group.Key">
                        @foreach (var q in group)
                        {
                            <option value="@q.Id">@q.Title</option>
                        }
                    </optgroup>
                }
            </select>
            <div class="hint">
                <span style="color:#4FD1C5;font-family:Consolas,monospace">@Selected.Rpc</span> - @Selected.Description
            </div>
        </div>

        @if (Selected.Has(DcsGrpcParam.Coalition) || Selected.Has(DcsGrpcParam.SpecificCoalition) || Selected.Has(DcsGrpcParam.GroupCategory))
        {
            <div class="row2">
                @if (Selected.Has(DcsGrpcParam.Coalition) || Selected.Has(DcsGrpcParam.SpecificCoalition))
                {
                    <div class="field">
                        <label>COALITION</label>
                        <select @bind="_input.Coalition">
                            @foreach (var c in DcsGrpcExplorer.Coalitions)
                            {
                                if (c == "All" && Selected.Has(DcsGrpcParam.SpecificCoalition)) continue;
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                }
                @if (Selected.Has(DcsGrpcParam.GroupCategory))
                {
                    <div class="field">
                        <label>CATEGORY</label>
                        <select @bind="_input.GroupCategory">
                            @foreach (var c in DcsGrpcExplorer.GroupCategories)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                }
            </div>
        }

        @if (Selected.Has(DcsGrpcParam.GroupName))
        {
            <div class="field">
                <label>GROUP NAME (as in the mission editor)</label>
                <input type="text" list="grpc-names" @bind="_input.GroupName" placeholder="e.g. Aerial-1" />
                <div class="hint">Tip: run "Groups" (or the snapshot) first - names found there are offered as suggestions here.</div>
            </div>
        }

        @if (Selected.Has(DcsGrpcParam.UnitName) || Selected.Has(DcsGrpcParam.Position))
        {
            <div class="field">
                <label>UNIT NAME (as in the mission editor, not the player name)</label>
                <input type="text" list="grpc-names" @bind="_input.UnitName" placeholder="e.g. Aerial-1-1" />
                <div class="hint">Tip: run "Player-occupied units", "Units of a group" or the snapshot first to get name suggestions.</div>
            </div>
        }

        @if (Selected.Has(DcsGrpcParam.Position))
        {
            <div class="row3">
                <div class="field">
                    <label>LATITUDE</label>
                    <input type="number" step="any" @bind="_input.Latitude" />
                </div>
                <div class="field">
                    <label>LONGITUDE</label>
                    <input type="number" step="any" @bind="_input.Longitude" />
                </div>
                <div class="field">
                    <label>ALTITUDE (m MSL)</label>
                    <input type="number" step="any" @bind="_input.AltitudeMeters" />
                </div>
            </div>
            <button class="link-action" @onclick="TakePositionFromUnit" disabled="@_running">
                <span>Take position from unit</span>
            </button>
            @if (_positionMessage != null)
            {
                <div class="hint" style="margin-top:-10px;margin-bottom:12px;font-size:11px;color:#8CA0A8">@_positionMessage</div>
            }
        }

        @if (Selected.Has(DcsGrpcParam.FlagName))
        {
            <div class="field">
                <label>FLAG NAME / NUMBER</label>
                <input type="text" @bind="_input.FlagName" placeholder="e.g. 1" />
            </div>
        }

        @if (Selected.Has(DcsGrpcParam.StreamDuration) || Selected.Has(DcsGrpcParam.PollRate))
        {
            <div class="row2">
                @if (Selected.Has(DcsGrpcParam.StreamDuration))
                {
                    <div class="field">
                        <label>LISTEN FOR (seconds, max @DcsGrpcExplorer.MaxStreamDurationSeconds)</label>
                        <input type="number" min="1" max="@DcsGrpcExplorer.MaxStreamDurationSeconds" @bind="_input.StreamDurationSeconds" />
                    </div>
                }
                @if (Selected.Has(DcsGrpcParam.PollRate))
                {
                    <div class="field">
                        <label>POLL RATE (seconds)</label>
                        <input type="number" min="1" max="60" @bind="_input.PollRateSeconds" />
                    </div>
                }
            </div>
            <div class="hint" style="margin-top:-6px;margin-bottom:12px;font-size:11px;color:#5A6A70">
                Stops after the time above or @DcsGrpcExplorer.MaxStreamMessages messages, whichever comes first.
            </div>
        }

        <div style="display:flex;gap:18px">
            <button class="link-action" @onclick="RunQuery" disabled="@_running">
                <span>@(_running && !_runningSnapshot ? RunningLabel : "Run query")</span>
            </button>
            @if (_running)
            {
                <button class="link-action" style="color:#E2543A" @onclick="Cancel"><span>Cancel</span></button>
            }
        </div>
    </div>

    <datalist id="grpc-names">
        @foreach (var n in _knownNames)
        {
            <option value="@n"></option>
        }
    </datalist>

    @if (_queryResult != null)
    {
        <div class="card" style="border-color:@(_queryResult.Success ? "#2E4E4C" : "#6C2E2E")">
            <div class="card-head" style="margin-bottom:6px">
                <span style="color:@(_queryResult.Success ? "#5FBF7A" : "#E2543A");font-size:14px">@(_queryResult.Success ? "✓" : "✕")</span>
                <span style="font-size:12.5px;color:#E7EDEF">@_resultTitle</span>
                <span class="spacer"></span>
                @if (_queryResult.Success)
                {
                    <button class="link-action" style="margin:0" @onclick="CopyJson"><span>Copy JSON</span></button>
                    <button class="link-action" style="margin:0" @onclick="SaveJson"><span>Save to file</span></button>
                }
            </div>
            <div style="font-size:12px;color:#8CA0A8">@_queryResult.Message</div>
            @if (_queryResult.Success && _queryResult.DiscoveredNames.Count > 0)
            {
                <div style="font-size:11px;color:#5A6A70;margin-top:4px">
                    @_queryResult.DiscoveredNames.Count name(s) found - now offered as suggestions in the unit/group name fields.
                </div>
            }
            @if (_actionMessage != null)
            {
                <div style="font-size:11px;color:#4FD1C5;margin-top:4px;word-break:break-all">@_actionMessage</div>
            }
            @if (_queryResult.Success)
            {
                <div class="log-tail" style="max-height:460px;margin-top:10px;user-select:text">@DisplayJson</div>
            }
        </div>
    }
}
}

@code {
    /// <summary>
    /// The three parts of this panel, each its own entry in the sidebar.
    ///
    /// This page holds the gRPC connection, every tactical and airfield reply setting, two test
    /// buttons and a 38-query mission explorer - which as one scrolling page was the one place in
    /// this editor where nobody could find anything. The sections are named by constant rather than
    /// by string literal so the sidebar and this panel cannot drift apart: a mistyped section would
    /// show an empty page and fail nowhere.
    /// </summary>
    public const string SectionServer = "server";
    public const string SectionReplies = "replies";
    public const string SectionExplorer = "explorer";

    /// <summary>Which section to show. Defaults to the connection, which is where setup starts.</summary>
    [Parameter] public string Section { get; set; } = SectionServer;

    private const int MaxDisplayChars = 300_000;

    private bool _testing;
    private DcsGrpcTestResult? _result;

    private string _airfieldKind = "RunwayInUse";
    private string _airfieldQuery = "";
    private bool _airfieldTesting;
    private string? _airfieldResult;

    private string _intelKind = "BogeyDope";
    private string _intelPlayerName = "";
    private bool _intelTesting;
    private string? _intelResult;

    // The trigger lists are edited as one comma-separated line each - shorter than a list editor
    // and these are rarely changed after the initial setup.
    private string BogeyDopeTriggers
    {
        get => string.Join(", ", Store.Config.DcsIntelBogeyDopeTriggers);
        set => Store.Config.DcsIntelBogeyDopeTriggers = SplitTriggers(value);
    }

    private string PictureTriggers
    {
        get => string.Join(", ", Store.Config.DcsIntelPictureTriggers);
        set => Store.Config.DcsIntelPictureTriggers = SplitTriggers(value);
    }

    private string AlphaCheckTriggers
    {
        get => string.Join(", ", Store.Config.DcsIntelAlphaCheckTriggers);
        set => Store.Config.DcsIntelAlphaCheckTriggers = SplitTriggers(value);
    }

    private string BullseyeTriggers
    {
        get => string.Join(", ", Store.Config.DcsIntelBullseyeTriggers);
        set => Store.Config.DcsIntelBullseyeTriggers = SplitTriggers(value);
    }

    private string ThreatTriggers
    {
        get => string.Join(", ", Store.Config.DcsIntelThreatTriggers);
        set => Store.Config.DcsIntelThreatTriggers = SplitTriggers(value);
    }

    private bool ThreatCircleDisabled => !Store.Config.DcsIntelEnabled || !Store.Config.DcsIntelThreatCircleEnabled;

    private bool FriendlyDisabled => !Store.Config.DcsIntelEnabled || !Store.Config.DcsIntelFriendlyPositionEnabled;

    private string FriendlyPositionTriggers
    {
        get => string.Join(", ", Store.Config.DcsIntelFriendlyPositionTriggers);
        set => Store.Config.DcsIntelFriendlyPositionTriggers = SplitTriggers(value);
    }

    private string ThreatCircleTriggers
    {
        get => string.Join(", ", Store.Config.DcsIntelThreatCircleTriggers);
        set => Store.Config.DcsIntelThreatCircleTriggers = SplitTriggers(value);
    }

    private string ThreatCircleCancelTriggers
    {
        get => string.Join(", ", Store.Config.DcsIntelThreatCircleCancelTriggers);
        set => Store.Config.DcsIntelThreatCircleCancelTriggers = SplitTriggers(value);
    }

    private string AirfieldRunwayTriggers
    {
        get => string.Join(", ", Store.Config.DcsAirfieldRunwayTriggers);
        set => Store.Config.DcsAirfieldRunwayTriggers = SplitTriggers(value);
    }

    private string AirfieldAtisTriggers
    {
        get => string.Join(", ", Store.Config.DcsAirfieldAtisTriggers);
        set => Store.Config.DcsAirfieldAtisTriggers = SplitTriggers(value);
    }

    private static List<string> SplitTriggers(string value) =>
        (value ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private async Task RunIntelTest()
    {
        _intelTesting = true;
        _intelResult = null;
        StateHasChanged();

        try
        {
            var service = new DcsIntelService(Store.Config);
            var kind = Enum.TryParse<IntelRequestKind>(_intelKind, out var parsed) ? parsed : IntelRequestKind.BogeyDope;

            // The transcript matters for one thing only here: a "bullseye" in it forces the
            // bullseye format. Feeding the first configured trigger keeps the test honest.
            var transcript = kind switch
            {
                IntelRequestKind.Picture => Store.Config.DcsIntelPictureTriggers.FirstOrDefault() ?? "picture",
                IntelRequestKind.Threat => Store.Config.DcsIntelThreatTriggers.FirstOrDefault() ?? "threat check",
                _ => Store.Config.DcsIntelBogeyDopeTriggers.FirstOrDefault() ?? "bogey dope"
            };

            var result = await service.AnswerAsync(kind, transcript, _intelPlayerName ?? "", senderCoalition: 0);
            _intelResult = string.IsNullOrWhiteSpace(result.Reply)
                ? $"No reply produced. ({result.Detail})"
                : $"{result.Reply}\n\n[{result.Detail}]";
        }
        catch (Exception ex)
        {
            _intelResult = $"Failed: {ex.Message}";
        }
        finally
        {
            _intelTesting = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Runs a real airfield request against the running mission and shows the exact sentence the
    /// bot would speak, plus where the data came from and why that runway was chosen. Nothing is
    /// transmitted. Works on the values currently on screen, so settings can be tried before saving.
    /// </summary>
    private async Task RunAirfieldTest()
    {
        _airfieldTesting = true;
        _airfieldResult = null;
        StateHasChanged();

        try
        {
            var service = new DcsAirfieldService(Store.Config, new DcsIntelService(Store.Config));
            var kind = Enum.TryParse<AirfieldRequestKind>(_airfieldKind, out var parsed)
                ? parsed
                : AirfieldRequestKind.RunwayInUse;

            // Whatever was typed is used two ways, exactly as on the radio: as an airfield name
            // inside the transcript, and as the pilot whose nearest airfield to fall back to.
            var trigger = kind == AirfieldRequestKind.Atis
                ? Store.Config.DcsAirfieldAtisTriggers.FirstOrDefault() ?? "atis"
                : Store.Config.DcsAirfieldRunwayTriggers.FirstOrDefault() ?? "runway in use";

            var transcript = $"{_airfieldQuery} {trigger}".Trim();

            var result = await service.AnswerAsync(kind, transcript, _airfieldQuery ?? "", senderCoalition: 0);
            _airfieldResult = string.IsNullOrWhiteSpace(result.Reply)
                ? $"No reply produced. ({result.Diagnostics})"
                : $"{result.Reply}\n\n[{result.Diagnostics}]";
        }
        catch (Exception ex)
        {
            _airfieldResult = $"Failed: {ex.Message}";
        }
        finally
        {
            _airfieldTesting = false;
            StateHasChanged();
        }
    }

    private string _queryId = DcsGrpcExplorer.Queries[0].Id;
    private readonly DcsGrpcQueryInput _input = new();
    private bool _running;
    private bool _runningSnapshot;
    private DateTime _runStarted;
    private CancellationTokenSource? _cts;
    private System.Threading.Timer? _ticker;
    private DcsGrpcQueryResult? _queryResult;
    private string _resultTitle = "";
    private string _resultId = "";
    private string? _actionMessage;
    private string? _positionMessage;
    private readonly SortedSet<string> _knownNames = new(StringComparer.OrdinalIgnoreCase);

    private DcsGrpcQueryInfo Selected =>
        DcsGrpcExplorer.Queries.FirstOrDefault(q => q.Id == _queryId) ?? DcsGrpcExplorer.Queries[0];

    private string RunningLabel => Selected.Has(DcsGrpcParam.StreamDuration)
        ? $"Listening... {(int)(DateTime.Now - _runStarted).TotalSeconds}s"
        : "Running...";

    private string DisplayJson => _queryResult == null ? "" :
        _queryResult.Json.Length <= MaxDisplayChars
            ? _queryResult.Json
            : _queryResult.Json[..MaxDisplayChars] + $"\n\n... (display truncated - {_queryResult.Json.Length:N0} characters total, use 'Save to file' for the full result)";

    private async Task RunTest()
    {
        _testing = true;
        _result = null;
        StateHasChanged();

        _result = await DcsGrpcTester.TestConnectionAsync(Store.Config.DcsGrpcAddress, Store.Config.DcsGrpcApiKey);

        _testing = false;
        StateHasChanged();
    }

    private Task RunQuery()
    {
        var q = Selected;
        // Bullseye can't use "All" - make sure a valid coalition is selected before running.
        if (q.Has(DcsGrpcParam.SpecificCoalition) && _input.Coalition == "All")
            _input.Coalition = "Blue";

        return Execute(q.Title, q.Id, false,
            token => DcsGrpcExplorer.RunAsync(Store.Config.DcsGrpcAddress, Store.Config.DcsGrpcApiKey, q.Id, _input, cancellationToken: token));
    }

    private Task RunSnapshot() =>
        Execute("Mission snapshot", "snapshot", true,
            token => DcsGrpcExplorer.RunSnapshotAsync(Store.Config.DcsGrpcAddress, Store.Config.DcsGrpcApiKey, cancellationToken: token));

    private async Task Execute(string title, string id, bool snapshot, Func<CancellationToken, Task<DcsGrpcQueryResult>> run)
    {
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _running = true;
        _runningSnapshot = snapshot;
        _runStarted = DateTime.Now;
        _actionMessage = null;
        _queryResult = null;

        // Refresh the "Listening... Ns" label once a second during streaming calls.
        _ticker = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
        StateHasChanged();

        try
        {
            _queryResult = await run(_cts.Token);
            _resultTitle = title;
            _resultId = id;
            foreach (var n in _queryResult.DiscoveredNames)
                _knownNames.Add(n);
        }
        finally
        {
            _ticker?.Dispose();
            _ticker = null;
            _running = false;
            StateHasChanged();
        }
    }

    private void Cancel() => _cts?.Cancel();

    private async Task TakePositionFromUnit()
    {
        _positionMessage = "Looking up position...";
        StateHasChanged();

        var (success, message, lat, lon, alt) = await DcsGrpcExplorer.GetUnitPositionAsync(
            Store.Config.DcsGrpcAddress, Store.Config.DcsGrpcApiKey, _input.UnitName);

        if (success)
        {
            _input.Latitude = Math.Round(lat, 6);
            _input.Longitude = Math.Round(lon, 6);
            _input.AltitudeMeters = Math.Round(alt, 1);
        }
        _positionMessage = message;
        StateHasChanged();
    }

    private async Task CopyJson()
    {
        if (_queryResult == null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _queryResult.Json);
            _actionMessage = "JSON copied to the clipboard.";
        }
        catch (Exception ex)
        {
            _actionMessage = $"Could not copy to the clipboard ({ex.Message}) - use 'Save to file' instead.";
        }
    }

    private void SaveJson()
    {
        if (_queryResult == null) return;
        try
        {
            var path = Store.SaveGrpcDump(_resultId, _queryResult.Json);
            _actionMessage = $"Saved to {path}";
        }
        catch (Exception ex)
        {
            _actionMessage = $"Could not save: {ex.Message}";
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _ticker?.Dispose();
    }
}
