@namespace Darkstar.Gui.Pages
@inject ConfigStore Store

<div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:16px">
    <h1 style="margin:0">RADIOS — PER-CHANNEL IDENTITY</h1>
    <span style="font-size:11px;color:#5A6A70">@Store.Config.Radios.Count active</span>
</div>

@if (Store.Config.Radios.Count == 0)
{
    <p style="color:#8CA0A8;font-size:12px">
        No entries in "Radios" yet - the bot falls back to the legacy single-radio fields
        (@Store.Config.FrequencyHz Hz, @Store.Config.Modulation). Add a radio below to switch to
        the multi-radio mode.
    </p>
}

@for (var i = 0; i < Store.Config.Radios.Count; i++)
{
    var radio = Store.Config.Radios[i];
    <div class="card">
        <div class="card-head">
            <input type="number" step="1000" @bind="radio.FrequencyHz" class="freq" style="background:transparent;border:none;width:130px;padding:0" />
            <select @bind="radio.Modulation" style="background:#161F24;border:1px solid #2A363C;border-radius:3px;color:#4FD1C5;font-size:11px;padding:3px 6px">
                <option value="AM">AM</option>
                <option value="FM">FM</option>
            </select>
            <span class="spacer"></span>
            <button class="icon-btn" title="Remove radio" @onclick="() => RemoveRadio(radio)">✕</button>
        </div>
        <div class="row2">
            <div class="field" style="margin-bottom:0">
                <label>WAKE WORD (empty = global default)</label>
                <input type="text" @bind="radio.Keyword" placeholder="@Store.Config.VoskKeyword" />
            </div>
            <div class="field" style="margin-bottom:0">
                <label>CALLSIGN (empty = global default)</label>
                <input type="text" @bind="radio.Callsign" placeholder="@Store.Config.BotCallsign" />
            </div>
        </div>

        <div class="field" style="margin-top:12px;margin-bottom:0">
            <label>ALSO ACCEPT AS THE WAKE WORD (comma separated)</label>
            @* value + onchange rather than @bind: the stored value is a list, the field is one
               comma-separated line, so the conversion has to happen on the way in and out. *@
            <input type="text" value="@VariantsFor(radio)" placeholder="@VariantsPlaceholder(radio)"
                   @onchange="e => SetVariants(radio, e.Value?.ToString() ?? string.Empty)" />
            <div class="hint">
                How the recognizer really hears it. A German speaker's "Overlord" often arrives as
                <code>over lord</code> — which fails the whole-word match on the space, so the bot stays
                silent. Every entry here also raises the false-trigger rate, so fill it from measurements:
                turn on <code>SaveRecordings</code> (CH3), fly a session, then run
                <code>Darkstar.exe --test-hotword recordings --suggest-variants</code>, which reads out what
                the model heard on the transmissions it missed and proposes the list.
                @if (string.IsNullOrWhiteSpace(radio.Keyword))
                {
                    <text>Empty here means this radio uses the global variants from CH3.</text>
                }
                else
                {
                    <text><strong>This radio has its own wake word, so it does not inherit the global
                    variants</strong> — otherwise it would answer to another radio's spellings.</text>
                }
            </div>
        </div>

        <div class="field" style="margin-top:12px;margin-bottom:0">
            <label>VOICE (empty = global default)</label>
            <input type="text" @bind="radio.Voice" list="tts-voices" placeholder="@GlobalVoicePlaceholder" />
        </div>

        <div class="row2" style="margin-top:12px">
            <div class="field" style="margin-bottom:0">
                <label>TACTICAL REQUESTS @(TacticalGloballyOn ? "" : "(globally off)")</label>
                @RoleButtons(radio.AnswerTacticalRequests, v => radio.AnswerTacticalRequests = v, TacticalGloballyOn)
                <div class="hint">Bogey dope, picture, threat check, threat circle.</div>
            </div>
            <div class="field" style="margin-bottom:0">
                <label>AIRFIELD REQUESTS @(AirfieldGloballyOn ? "" : "(globally off)")</label>
                @RoleButtons(radio.AnswerAirfieldRequests, v => radio.AnswerAirfieldRequests = v, AirfieldGloballyOn)
                <div class="hint">Runway in use and ATIS.</div>
            </div>
        </div>

        <div class="field" style="margin-top:12px;margin-bottom:0">
            <label>FRIENDLY POSITIONS @(FriendlyGloballyOn ? "" : "(globally off)")</label>
            @RoleButtons(radio.AnswerFriendlyPositionRequests, v => radio.AnswerFriendlyPositionRequests = v, FriendlyGloballyOn)
            <div class="hint">
                "Where is Springfield 2-1?" — only human players on the caller's own side. Its own role
                rather than part of the tactical one: that is about the enemy, this is about your own
                people, and a server may well want it on one squadron frequency and nowhere else.
                Switched on globally on CH8.
            </div>
        </div>

        <div class="hint" style="margin-top:8px">
            This radio answers: <strong>@radio.DescribeRole(TacticalGloballyOn, AirfieldGloballyOn, FriendlyGloballyOn)</strong>.
            Phrases and free answers always work on every radio.
        </div>
    </div>
}

@* One shared list for every voice field on this page - the browser offers it as autocomplete.
   Deliberately an autocomplete and not a dropdown: with Azure or Google configured, the valid
   voice names are the provider's, and this machine has never heard of them. A picker would make
   exactly the best-sounding option impossible to enter. *@
@if (Store.TtsVoiceList.Count > 0)
{
    <datalist id="tts-voices">
        @foreach (var voice in Store.TtsVoiceList)
        {
            <option value="@voice.Name">@voice.Describe()</option>
        }
    </datalist>
}

<div class="card" style="margin:4px 0 12px">
    <div class="card-head" style="margin-bottom:6px">
        <span style="font-size:12.5px;color:#E7EDEF">Voices on this machine</span>
        <span class="spacer"></span>
        <button class="link-action" style="margin-bottom:0" disabled="@Store.TtsVoicesLoading"
                @onclick="() => Store.LoadTtsVoicesAsync(force: true)">
            <span>@(Store.TtsVoicesLoading ? "Asking..." : "List available voices")</span>
        </button>
    </div>

    @if (Store.TtsVoiceStatus != null)
    {
        <div style="font-size:11.5px;color:@(Store.TtsVoiceStatusIsError ? "#F2A93B" : "#5FBF7A")">
            @Store.TtsVoiceStatus
        </div>
    }

    @if (Store.TtsVoiceList.Count > 0)
    {
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px">
            @foreach (var voice in Store.TtsVoiceList)
            {
                <span style="font-size:11px;color:#8CA0A8;border:1px solid #2A363C;border-radius:3px;padding:3px 7px">
                    @voice.Describe()
                </span>
            }
        </div>
    }

    <div class="hint" style="margin-top:8px">
        Read straight out of <code>DCS-SR-ExternalAudio.exe</code>, which is the only list that counts:
        it speaks through SAPI5, so Windows' own "natural" voices are usually invisible to it even
        though the system settings show them. A name that isn't here fails silently — no audio, no
        error. Azure or Google voice names won't appear either; type those in by hand and set the
        credentials in <code>ExternalAudioExtraArgs</code> on CH3.
    </div>
</div>

<p style="color:#8CA0A8;font-size:11.5px;margin:4px 0 12px">
    Splitting the roles is how you get a tower: give one frequency the airfield requests and turn
    its tactical requests off, and the other way round on the AWACS frequency. Each gets its own
    wake word and callsign above. A pilot who calls the wrong one is told where to go instead of
    being refused.
</p>

<div class="field" style="max-width:620px">
    <label>REPLY THAT POINTS AT THE RIGHT FREQUENCY</label>
    <input type="text" @bind="Store.Config.WrongChannelReply" />
    <div class="hint">
        <code>{callsign}</code> the radio that does serve the request, <code>{frequency}</code> its
        frequency. Used only when <strong>exactly one</strong> other radio serves it — with two towers
        configured there is no single right answer, so the transmission falls through to
        <code>phrases.json</code> instead of a guess. Emptying this field switches the handoff off.
    </div>
</div>

<button class="link-action" @onclick="AddRadio"><span>+ Add radio</span></button>

<div class="card" style="margin-top:10px">
    <div class="card-head" style="margin-bottom:6px">
        <span style="font-size:12.5px;color:#E7EDEF">One tower per airfield</span>
        <span class="spacer"></span>
        <button class="link-action" style="margin-bottom:0" disabled="@(_planning || GeneratedCount == 0)"
                @onclick="RemoveGeneratedTowers">
            <span>@(GeneratedCount == 0 ? "No generated towers" : $"Remove {GeneratedCount} generated tower(s)")</span>
        </button>
        <button class="link-action" style="margin-bottom:0" disabled="@(_planning || !Store.Config.DcsGrpcEnabled)"
                @onclick="GenerateTowers">
            <span>@(_planning ? "Asking the mission..." : "Generate from the running mission")</span>
        </button>
    </div>

    <div style="font-size:11px;color:#5A6A70;margin-bottom:10px">
        Reads the airfields from the mission that is loaded right now and adds one radio per airfield —
        callsign <code>&lt;airfield&gt; @Store.Config.TowerPlanCallsignSuffix</code>, airfield requests on,
        tactical off. Existing radios are kept and their frequencies skipped, so generating is
        <strong>additive</strong>: changing map means removing the old towers first, which is what the
        other button is for. It recognises them by callsign suffix, airfield-only role and no own wake
        word — so a hand-built radio matching all of that counts as generated too. Nothing is saved
        until you press Save changes.
    </div>

    <div class="row4">
        <div class="field" style="margin-bottom:0">
            <label>FIRST FREQUENCY (MHZ)</label>
            <input type="number" step="0.025" @bind="Store.Config.TowerPlanBaseMHz" />
        </div>
        <div class="field" style="margin-bottom:0">
            <label>STEP (MHZ)</label>
            <input type="number" step="0.025" @bind="Store.Config.TowerPlanStepMHz" />
        </div>
        <div class="field" style="margin-bottom:0">
            <label>CALLSIGN SUFFIX</label>
            <input type="text" @bind="Store.Config.TowerPlanCallsignSuffix" placeholder="(airfield name only)" />
        </div>
        <div class="field" style="margin-bottom:0">
            <label>MODULATION</label>
            <select @bind="Store.Config.TowerPlanModulation" style="background:#161F24;border:1px solid #2A363C;border-radius:4px;color:#E7EDEF;padding:7px 10px;width:100%">
                <option value="AM">AM</option>
                <option value="FM">FM</option>
            </select>
        </div>
    </div>

    <div class="card" style="border-color:#6C5A2E;background:#241F12;margin:10px 0 0">
        <div style="font-size:11.5px;color:#F2A93B">
            <strong>These frequencies are invented.</strong> DCS-gRPC does not report an airfield's real
            radio frequency — the <code>Airbase</code> data carries a name, a coalition and a position and
            nothing else. So pick a range your mission doesn't use for something else, and leave the
            announcement in the card below switched on: an F10 marker is the only place your pilots can
            learn these numbers.
        </div>
    </div>

    <div class="hint" style="margin-top:8px">
        The wake word stays the global one on purpose. An airfield name as a wake word — "Kobuleti",
        "Senaki-Kolkhi" — through a small English speech model is the failure the position-based airfield
        lookup exists to avoid, and as a wake word a miss means the bot never answers at all. The
        <em>frequency</em> identifies the airfield; the bot replies as "@(string.IsNullOrWhiteSpace(Store.Config.TowerPlanCallsignSuffix) ? "Batumi" : "Batumi " + Store.Config.TowerPlanCallsignSuffix)".
    </div>

    @if (_planNotes.Count > 0)
    {
        <div style="margin-top:10px">
            @foreach (var note in _planNotes)
            {
                <div style="font-size:11.5px;color:@(_planFailed ? "#F2A93B" : "#5FBF7A")">@note</div>
            }
        </div>
    }
</div>

<div class="card" style="margin-top:10px">
    <div class="card-head" style="margin-bottom:6px">
        <span style="font-size:12.5px;color:#E7EDEF">Announce the frequencies in game</span>
        <span class="spacer"></span>
        <div class="toggle-row" style="margin:0;padding:0;border:0;background:none;gap:8px">
            <button class="toggle @(Store.Config.AnnounceFrequenciesEnabled ? "on" : "")"
                    @onclick="() => Store.Config.AnnounceFrequenciesEnabled = !Store.Config.AnnounceFrequenciesEnabled">
                <span class="knob"></span>
            </button>
        </div>
    </div>

    <div style="font-size:11px;color:#5A6A70;margin-bottom:10px">
        The counterpart to the generated towers: at startup the bot writes its frequencies into the
        running mission, because invented frequencies appear in no briefing and on no kneeboard.
        On by default — this is the only place your pilots can learn them.
    </div>

    @if (!Store.Config.DcsGrpcEnabled)
    {
        <div class="card" style="border-color:#6C2E2E;font-size:12px;color:#F2A93B;margin:0 0 10px">
            DCS-gRPC is switched off (CH8 → Server &amp; test). Writing into a mission needs it, so
            nothing will be announced — the frequencies then have to reach your pilots some other way.
        </div>
    }

    <div style="opacity:@(Store.Config.AnnounceFrequenciesEnabled ? "1" : "0.5")">
        <div class="toggle-row" style="margin:0 0 4px 0">
            <div>
                <div>One F10 map marker per airfield</div>
                <div style="font-size:11px;color:#5A6A70;margin-top:3px">
                    The durable half: stays for the whole mission, names the tower that serves that field
                    plus the radios that are not tied to one, and can be read whenever somebody needs it.
                    Read-only, own coalition only, and a fixed id range — a restarted bot replaces its
                    markers instead of stacking a second set.
                </div>
            </div>
            <button class="toggle @(Store.Config.AnnounceFrequenciesMarkers ? "on" : "")"
                    disabled="@(!Store.Config.AnnounceFrequenciesEnabled)"
                    @onclick="() => Store.Config.AnnounceFrequenciesMarkers = !Store.Config.AnnounceFrequenciesMarkers">
                <span class="knob"></span>
            </button>
        </div>

        <div class="toggle-row" style="margin:0 0 4px 0">
            <div>
                <div>One on-screen message at startup</div>
                <div style="font-size:11px;color:#5A6A70;margin-top:3px">
                    The transient half, for whoever is already flying when the bot comes up. Lists the
                    radios that are not tied to an airfield in full and summarises the towers, because a
                    dozen of them would scroll off the screen.
                </div>
            </div>
            <button class="toggle @(Store.Config.AnnounceFrequenciesMessage ? "on" : "")"
                    disabled="@(!Store.Config.AnnounceFrequenciesEnabled)"
                    @onclick="() => Store.Config.AnnounceFrequenciesMessage = !Store.Config.AnnounceFrequenciesMessage">
                <span class="knob"></span>
            </button>
        </div>

        <div class="field" style="max-width:320px;margin:10px 0 0">
            <label>MESSAGE STAYS ON SCREEN (SECONDS)</label>
            <input type="number" min="1" step="5" @bind="Store.Config.AnnounceFrequenciesMessageSeconds"
                   disabled="@(!Store.Config.AnnounceFrequenciesEnabled || !Store.Config.AnnounceFrequenciesMessage)" />
        </div>
    </div>

    <div class="hint" style="margin-top:10px">
        Runs once, after the SRS connection is up — announcing frequencies the bot then fails to monitor
        would be worse than silence — and off the startup path, so a mission that is still loading never
        delays the first transmission. Whatever happens is logged as <code>[Announce]</code>; a failure
        changes nothing else.
    </div>
</div>

<div class="card" style="margin-top:10px">
    <div class="card-head" style="margin-bottom:6px">
        <span style="font-size:12.5px;color:#E7EDEF">Greet a pilot who tunes in</span>
        <span class="spacer"></span>
        <div class="toggle-row" style="margin:0;padding:0;border:0;background:none;gap:8px">
            <button class="toggle @(Store.Config.TuneInGreetingEnabled ? "on" : "")"
                    @onclick="() => Store.Config.TuneInGreetingEnabled = !Store.Config.TuneInGreetingEnabled">
                <span class="knob"></span>
            </button>
        </div>
    </div>

    <div style="font-size:11px;color:#5A6A70;margin-bottom:10px">
        SRS reports which frequencies every client has tuned. When somebody dials one of these radios in,
        the bot says which channel they reached and where the tactical radio is — the one thing an F10
        marker at their departure field cannot tell them once they are airborne.
    </div>

    <div class="field">
        <label>WHAT TO SAY</label>
        <input type="text" @bind="Store.Config.TuneInGreetingText" />
        <div class="hint">
            <code>{pilot}</code> the caller, <code>{callsign}</code> the channel they reached,
            <code>{tactical}</code> the radios that answer tactical requests. An empty placeholder leaves
            no gap or dangling comma behind, and an empty line switches the greeting off as surely as the
            toggle does.
        </div>
    </div>

    <div class="field" style="margin-bottom:0">
        <label>MINIMUM SECONDS BETWEEN GREETINGS ON ONE FREQUENCY</label>
        <input type="number" min="5" step="5" @bind="Store.Config.TuneInGreetingGapSeconds" />
    </div>

    <div class="card" style="border-color:#6C5A2E;background:#241F12;margin:10px 0 0">
        <div style="font-size:11.5px;color:#F2A93B">
            <strong>SRS has no unicast.</strong> This greeting goes to <em>everybody</em> on the frequency,
            not just to the pilot who tuned in — which is why it is off by default. Each client is greeted
            once per frequency for the whole session and never again, and the gap above means a flight of
            four checking in together hears one greeting instead of four. Switch it on while the generated
            tower frequencies are new to your pilots, and off again once they know them.
        </div>
    </div>
</div>

<div class="card" style="margin-top:10px">
    <div style="font-size:12.5px;color:#E7EDEF;font-weight:600;margin-bottom:10px">Legacy single-radio fields</div>
    <div class="hint" style="margin-bottom:10px">Only used when the list above is empty.</div>
    <div class="row2">
        <div class="field" style="margin-bottom:0">
            <label>FREQUENCY (HZ)</label>
            <input type="number" @bind="Store.Config.FrequencyHz" />
        </div>
        <div class="field" style="margin-bottom:0">
            <label>MODULATION</label>
            <select @bind="Store.Config.Modulation" style="background:#161F24;border:1px solid #2A363C;border-radius:4px;color:#E7EDEF;padding:7px 10px;width:100%">
                <option value="AM">AM</option>
                <option value="FM">FM</option>
            </select>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// The master switches. A radio can narrow what it answers, never widen it, so the buttons
    /// are shown greyed out when the feature is off everywhere - otherwise switching one on here
    /// would look like it did something.
    /// </summary>
    private bool TacticalGloballyOn => Store.Config.DcsIntelEnabled && Store.Config.DcsGrpcEnabled;
    private bool AirfieldGloballyOn => TacticalGloballyOn && Store.Config.DcsAirfieldEnabled;
    private bool FriendlyGloballyOn => TacticalGloballyOn && Store.Config.DcsIntelFriendlyPositionEnabled;

    /// <summary>
    /// What an empty voice field falls back to, spelled out rather than left blank - "empty =
    /// global default" is only useful if you can see what the global default currently is.
    /// </summary>
    /// <summary>
    /// The variant list as one editable line. Bound through a helper rather than directly, because
    /// the underlying value is a list and the field is comma-separated text.
    /// </summary>
    private string VariantsFor(RadioConfig radio)
    {
        return string.Join(", ", radio.KeywordVariants);
    }

    private void SetVariants(RadioConfig radio, string value)
    {
        radio.KeywordVariants = value
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
    }

    /// <summary>
    /// What this radio falls back to - which depends on whether it uses the global wake word, since
    /// variants follow the word rather than the radio.
    /// </summary>
    private string VariantsPlaceholder(RadioConfig radio)
    {
        if (!string.IsNullOrWhiteSpace(radio.Keyword)) return "(none — own wake word)";

        return Store.Config.VoskKeywordVariants.Count > 0
            ? string.Join(", ", Store.Config.VoskKeywordVariants)
            : "(none)";
    }

    private string GlobalVoicePlaceholder =>
        string.IsNullOrWhiteSpace(Store.Config.VoiceName)
            ? "(whatever ExternalAudio picks)"
            : Store.Config.VoiceName;

    /// <summary>
    /// A three-way choice: Default follows the global switch, On and Off decide for this radio.
    /// Default is kept as its own state rather than resolved into a plain yes/no, so a radio left
    /// alone keeps following the master switch when that changes later.
    /// </summary>
    private RenderFragment RoleButtons(bool? value, Action<bool?> set, bool enabled) => builder =>
    {
        var options = new (string Label, bool? Value)[] { ("Default", null), ("On", true), ("Off", false) };

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "row3");

        var sequence = 2;
        foreach (var (label, optionValue) in options)
        {
            var selected = value == optionValue;
            var colour = optionValue switch
            {
                true => selected ? "#5FBF7A" : "#5A6A70",
                false => selected ? "#E2543A" : "#5A6A70",
                _ => selected ? "#E7EDEF" : "#5A6A70"
            };
            var border = selected
                ? optionValue switch { true => "#2E4E4C", false => "#6C2E2E", _ => "#3A474D" }
                : "#2A363C";
            var background = selected
                ? optionValue switch { true => "#16302A", false => "#2A1614", _ => "#1B2429" }
                : "transparent";

            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "class", "link-action");
            builder.AddAttribute(sequence++, "style",
                $"justify-content:center;border:1px solid {border};border-radius:4px;padding:6px;" +
                $"color:{colour};background:{background};opacity:{(enabled ? "1" : "0.45")}");
            builder.AddAttribute(sequence++, "disabled", !enabled);

            var captured = optionValue;
            builder.AddAttribute(sequence++, "onclick",
                Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => set(captured)));

            builder.AddContent(sequence++, label);
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    /// <summary>
    /// How many radios look generated. Read on every render rather than cached, because the list
    /// changes underneath it when rows are added or removed by hand.
    /// </summary>
    private int GeneratedCount =>
        TowerPlan.GeneratedRadios(Store.Config.Radios, Store.Config).Generated.Count;

    /// <summary>
    /// Takes the generated towers back out, so regenerating for a different map replaces them instead
    /// of adding a second set. Hand-built radios are left alone - see TowerPlan.LooksGenerated for
    /// what counts, and for why an empty callsign suffix makes this refuse rather than guess.
    /// </summary>
    private void RemoveGeneratedTowers()
    {
        var found = TowerPlan.GeneratedRadios(Store.Config.Radios, Store.Config);

        _planFailed = found.Generated.Count == 0;
        _planNotes = new List<string>(found.Notes);

        if (found.Generated.Count == 0) return;

        foreach (var radio in found.Generated)
            Store.Config.Radios.Remove(radio);

        _planNotes.Insert(0, $"Removed {found.Generated.Count} generated tower(s). " +
            $"{Store.Config.Radios.Count} radio(s) left.");
        _planNotes.Add("Not saved yet - press Discard to get them back, or Save changes to keep this.");
    }

    private bool _planning;
    private bool _planFailed;
    private List<string> _planNotes = new();

    /// <summary>
    /// Asks the running mission for its airfields and adds a tower radio for each. Additive: whatever
    /// is already configured stays, and its frequencies are treated as taken rather than reused.
    /// </summary>
    private async Task GenerateTowers()
    {
        _planning = true;
        _planNotes = new List<string> { "Asking DCS-gRPC for the airfield list..." };
        _planFailed = false;

        try
        {
            // DcsAirfieldService needs the intel service for the pilot lookup, which this call does
            // not use - the airfield list needs no requester.
            var service = new DcsAirfieldService(Store.Config, new DcsIntelService(Store.Config));
            var airfields = await service.ListAirfieldsAsync();

            var reserved = Store.Config.Radios.Select(r => r.FrequencyHz).ToList();
            var plan = TowerPlan.Plan(airfields, Store.Config, reserved);

            _planNotes = new List<string>(plan.Notes);
            _planFailed = !plan.Any;

            if (plan.Any)
            {
                Store.Config.Radios.AddRange(TowerPlan.ToRadios(plan));
                _planNotes.Insert(0, $"Added {plan.Towers.Count} tower(s): " +
                    string.Join(", ", plan.Towers.Select(t => $"{t.Callsign} {t.FrequencyHz / 1_000_000:0.000}")));
                _planNotes.Add("Not saved yet - review the list above, then press Save changes.");
            }
        }
        catch (Exception ex)
        {
            _planFailed = true;
            _planNotes = new List<string> { $"Could not generate the towers: {ex.Message}" };
        }
        finally
        {
            _planning = false;
        }
    }

    private void AddRadio()
    {
        Store.Config.Radios.Add(new RadioConfig { FrequencyHz = 251_000_000, Modulation = "AM" });
    }

    private void RemoveRadio(RadioConfig radio)
    {
        Store.Config.Radios.Remove(radio);
    }
}
