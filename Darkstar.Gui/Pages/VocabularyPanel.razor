@namespace Darkstar.Gui.Pages
@inject ConfigStore Store

<h1>VOCABULARY</h1>
<p style="color:#8CA0A8;font-size:11.5px;margin-top:-8px;margin-bottom:16px">
    Proper nouns speech recognition should transcribe exactly - callsigns, aircraft types, map
    names. <strong>Not</strong> what the bot responds to; that is CH4 Phrases.
</p>

@{
    var conflicts = AppConfig.FindVocabularyTriggerConflicts(Store.Config, Store.Vocabulary);
}
@if (conflicts.Count > 0)
{
    <div class="card" style="border-color:#6C2E2E;background:#2A1614;margin-bottom:16px">
        <div style="font-size:12px;color:#E2543A;font-weight:600;margin-bottom:6px">
            @conflicts.Count term(s) here are also trigger phrases
        </div>
        <div style="font-size:11.5px;color:#8CA0A8">
            <strong>@string.Join(", ", conflicts)</strong> — these belong in one list or the other, not both.
            Speech recognition is told to snap anything that merely <em>sounds like</em> a term here onto its
            exact spelling, which is what makes these hints work. It does that to unclear audio too, so a
            command phrase in this list turns a mumble into that command — and the bot answers it instead of
            asking you to repeat. Remove them here; the trigger phrases keep working on their own.
        </div>
    </div>
}

<div style="margin-bottom:16px">
    @foreach (var term in Store.Vocabulary)
    {
        var isConflict = conflicts.Contains(term, StringComparer.OrdinalIgnoreCase);
        <span class="chip" style="@(isConflict ? "border-color:#6C2E2E;color:#E2543A" : "")" title="@(isConflict ? "Also a trigger phrase - see the warning above" : "")">
            @term
            <span class="x" @onclick="() => RemoveTerm(term)">✕</span>
        </span>
    }
</div>

<div class="field" style="max-width:360px;display:flex;gap:8px;align-items:flex-end">
    <div style="flex:1">
        <label>NEW TERM</label>
        <input type="text" @bind="_newTerm" @bind:event="oninput" @onkeydown="OnKeyDown" placeholder="e.g. Viggen" />
    </div>
    <button class="link-action" style="margin-bottom:9px" @onclick="AddTerm"><span>Add</span></button>
</div>

@code {
    private string _newTerm = "";

    private void AddTerm()
    {
        var term = _newTerm.Trim();
        if (string.IsNullOrEmpty(term)) return;
        if (!Store.Vocabulary.Contains(term, StringComparer.OrdinalIgnoreCase))
            Store.Vocabulary.Add(term);
        _newTerm = "";
    }

    private void RemoveTerm(string term) => Store.Vocabulary.Remove(term);

    private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTerm();
    }
}
