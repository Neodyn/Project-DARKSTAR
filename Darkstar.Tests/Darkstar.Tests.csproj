<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Darkstar.Tests</RootNamespace>
    <AssemblyName>Darkstar.Tests</AssemblyName>

    <!--
      Not packed into any installer: this project exists to be run from the repository, and
      build-installer.ps1 only ever publishes Darkstar and Darkstar.Gui.
    -->
    <IsPackable>false</IsPackable>

    <!-- The assertions are the documentation here, so missing XML comments are not interesting. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Core only, on purpose. Everything under test is either in Darkstar.Core or is asserted by
      reading its source file as text - so the tests do not drag the bot's Vosk and Opus native
      dependencies into a run that has no audio to process.
    -->
    <ProjectReference Include="..\Darkstar.Core\Darkstar.Core.csproj" />
  </ItemGroup>

</Project>
