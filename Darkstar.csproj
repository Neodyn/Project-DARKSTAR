<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Darkstar</RootNamespace>
    <AssemblyName>Darkstar</AssemblyName>
    <AssemblyTitle>D.A.R.K.S.T.A.R.</AssemblyTitle>
    <Product>D.A.R.K.S.T.A.R. - Digital Assistant for Radio Keyword-activated Speech Transcription And Response</Product>

    <!--
      Which build is this? Answered by VersionInfo (Darkstar.Core), shown in the bot's startup log,
      in the config editor's title bar and by the version switch of Darkstar.exe.

      The default says "not a release" on purpose: a binary built in the IDE should be
      distinguishable from one the installer script made. build-installer.ps1 overrides both
      properties, and the InformationalVersion it passes carries the UTC build time
      ("1.2+build.20261008143300"). That suffix is load-bearing rather than decorative - it makes
      every build's version unique, which forces a recompile even when a source file's timestamp
      lies in the past, and it is what the script reads back out of the published assembly to
      prove the installer is packing the build it just made.
    -->
    <Version>0.0.0</Version>
    <InformationalVersion>0.0.0-dev</InformationalVersion>

    <!--
      What ends up in the installer. Everything here is about NOT shipping files the bot never
      reads on the target machine - see docs\building-the-installer.md.

      SatelliteResourceLanguages: the gRPC and protobuf packages ship localized resource DLLs in
      a subfolder per language (cs\, de\, es\, fr\, ja\, ru\, zh-Hans\ ...). This bot's own output
      is English throughout - the radio phraseology is not translatable - so those folders are
      pure freight in the installer.

      AllowedReferenceRelatedFileExtensions: the default also copies each referenced assembly's
      XML API documentation next to its DLL. That is for people writing code against a library,
      not for running one. Narrowed to .pdb, which is kept ON PURPOSE: a Windows Service leaves no
      trace anywhere except its log file, and without the symbols the stack traces in that log
      lose their line numbers - which is precisely when they stop being useful. A few hundred KB
      against diagnosable failures is a trade worth making.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!--
    IMPORTANT: SDK-style projects compile every .cs file under the project folder by default, and
    this .csproj sits in the repository root - so Darkstar.Core, Darkstar.Gui and Darkstar.Tests all
    live *underneath* it and would be compiled into the bot as well.

    This one line excludes every .cs file in any subfolder, which is exactly right here because all
    of the bot's own sources sit directly in the root. It deliberately replaces the older list of one
    Remove per sibling project: that list had to be extended by hand whenever a project was added,
    and forgetting it produces errors that point nowhere near the cause -

      "Duplicate 'System.Reflection.AssemblyTitleAttribute' attribute"   (from the other project's
                                                                         generated obj\ files)
      "Only one compilation unit can have top-level statements"          (two Program.cs files)

    If the bot ever does grow a subfolder of its own sources, add a matching
    <Compile Include="Thatfolder\**\*.cs" /> rather than weakening this exclusion.
  -->
  <ItemGroup>
    <Compile Remove="*\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Darkstar.Core\Darkstar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure .NET Opus codec with no native DLLs, for SRS audio (48kHz, mono) -->
    <PackageReference Include="Concentus" Version="2.2.2" />

    <!-- Vosk: offline speech recognition, no account/cloud needed at all. Default (and only)
         wake word detection path in this project. The model must be downloaded separately,
         see the README. -->
    <PackageReference Include="Vosk" Version="0.3.38" />

    <!-- Generic Host: lets the bot run either as a normal console app (for testing) or as a
         real Windows Service (for unattended background operation), using the same .exe. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />

    <!-- Optional, if you use Azure Speech for STT/TTS instead of another engine.
         Alternatives: Vosk (offline STT), Whisper.net (offline STT), Piper (offline TTS) -->
    <!-- <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.40.0" /> -->
  </ItemGroup>

</Project>
