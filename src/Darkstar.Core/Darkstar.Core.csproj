<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Darkstar</RootNamespace>

    <!--
      Which build is this? Answered by VersionInfo (Darkstar.Core), shown in the bot's startup log,
      in the config editor's title bar and by the version switch of Darkstar.exe.

      The default says "not a release" on purpose: a binary built in the IDE should be
      distinguishable from one the installer script made. build-installer.ps1 overrides both
      properties, and the InformationalVersion it passes carries the UTC build time
      ("1.2+build.20261008143300"). That suffix is load-bearing rather than decorative - it makes
      every build's version unique, which forces a recompile even when a source file's timestamp
      lies in the past, and it is what the script reads back out of the published assembly to
      prove the installer is packing the build it just made.
    -->
    <Version>0.0.0</Version>
    <InformationalVersion>0.0.0-dev</InformationalVersion>
  </PropertyGroup>

  <!--
    Shared logic used by BOTH the bot service (Darkstar.csproj) and the GUI config editor
    (Darkstar.Gui.csproj): loading/saving/validating config.json, phrases.json, vocabulary.json,
    the automatic pre-write backup, and the console/file logger. Keeping this in one place means
    the GUI edits the exact same data model the bot actually runs on - no separate parsing logic
    to keep in sync.
  -->

  <!--
    The test project reaches the internal helpers it exercises. Those are internal rather than public
    because they are implementation detail - the bearing arithmetic, the retention decision, the
    variant suggestion - and making them public just to test them would turn every one of them into
    a promise to whoever writes the next feature.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Darkstar.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Official DCS-gRPC C# bindings (generated from the DCS-gRPC .proto files) - lets us
         talk to a running DCS-gRPC server for real mission data. Used by the GUI's connection
         test and read-only mission data explorer (DcsGrpcTester.cs, DcsGrpcExplorer.cs) and by
         the tactical replies and the threat circle (DcsIntelService.cs, ThreatCircleService.cs). -->
    <PackageReference Include="RurouniJones.Dcs.Grpc" Version="0.7.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Google.Protobuf" Version="3.28.2" />
  </ItemGroup>

</Project>
