@namespace Darkstar.Gui.Pages
@* A small line icon for a button, drawn in the button's own colour (the .ico rules in app.css).
   Busy swaps it for a spinner, so a button that is waiting says so without changing its size.
   The shapes are plain SVG paths on a 24 x 24 grid - the editor runs offline, so no icon font. *@

<svg class="ico @(Busy ? "spin" : "")" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="@(Busy ? Paths["busy"] : Paths.GetValueOrDefault(Name, Paths["go"]))" />
</svg>

@code {
    /// <summary>Which icon: one of the keys of <see cref="Paths"/>.</summary>
    [Parameter] public string Name { get; set; } = "go";

    /// <summary>True while the button's action runs: shows a turning spinner instead.</summary>
    [Parameter] public bool Busy { get; set; }

    [Parameter] public int Size { get; set; } = 15;

    /// <summary>Every icon the editor uses. EditorPanelTests checks that every name a panel asks for is here.</summary>
    public static readonly IReadOnlyDictionary<string, string> Paths = new Dictionary<string, string>
    {
        ["add"] = "M12 5v14M5 12h14",
