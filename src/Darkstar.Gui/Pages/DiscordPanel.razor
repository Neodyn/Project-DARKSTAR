@namespace Darkstar.Gui.Pages
@inject ConfigStore Store

<h1>DISCORD NOTIFICATIONS</h1>

<div class="toggle-row">
    <span>Enable Discord notifications</span>
    <button class="toggle @(Store.Config.DiscordEnabled ? "on" : "")" @onclick="() => Store.Config.DiscordEnabled = !Store.Config.DiscordEnabled">
        <span class="knob"></span>
    </button>
</div>

<div class="field" style="opacity:@(Store.Config.DiscordEnabled ? "1" : "0.5")">
    <label>WEBHOOK URL</label>
    <input type="text" @bind="Store.Config.DiscordWebhookUrl" placeholder="https://discord.com/api/webhooks/..." disabled="@(!Store.Config.DiscordEnabled)" />
    <div class="hint">Discord channel Settings -> Integrations -> Webhooks -> New Webhook.</div>
</div>

<div style="font-size:10px;letter-spacing:1px;color:#5A6A70;margin:16px 0 8px">SENDS A MESSAGE ON</div>
<div style="display:flex;flex-direction:column;gap:8px;font-size:12px;color:#8CA0A8">
    <span>✓ Bot started and connected (with the frequencies it is monitoring)</span>
    <span>✓ SRS connection lost / restored — once per outage, not once per retry</span>
    <span>✓ Bot shutting down</span>
    <span>✓ Bot could not start, with the reason</span>
    <span>✓ Bot stopped unexpectedly, with the error</span>
</div>
