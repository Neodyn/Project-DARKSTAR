@namespace Darkstar.Gui.Pages
@implements IDisposable
@inject ConfigStore Store
@inject IPathPicker Picker

<h1>PROFILES</h1>

<div class="field">
    <label>CONFIG FOLDER</label>
    <div class="path-row">
        <input type="text" @bind="_folder" />
        <button class="browse" @onclick="BrowseFolder">Browse...</button>
    </div>
    <div class="hint">
        The folder the bot reads <code>config.json</code>, <code>phrases.json</code> and
        <code>vocabulary.json</code> from — the one its <code>Darkstar.exe</code> sits in. The bot
        names this folder in the first lines of its log (<em>Settings read from: …</em>); if that
        path is not this one, the two of you are editing different files.
    </div>
</div>

<div style="display:flex;align-items:center;gap:16px;margin:-4px 0 16px">
    <button class="link-action" style="margin:0" @onclick="ApplyFolder"><span>Use this folder and load</span></button>

    @if (Store.FolderWasChosen)
    {
        <span class="badge">remembered</span>
        <button class="link-action" style="margin:0" @onclick="Store.ForgetChosenFolder"><span>Forget it</span></button>
    }
    else
    {
        <span style="font-size:11px;color:var(--faint)">Found automatically — using it once remembers it for the next start.</span>
    }
</div>

<div class="field">
    <label>PROFILES FOLDER</label>
    <input type="text" value="@ConfigProfiles.FolderFor(Store.ConfigFolder)" readonly />
    <div class="hint">
        A profile is a whole <code>config.json</code> kept here under its own name. Activating one
        copies it over the <code>config.json</code> the bot reads, keeping a backup of the one that
        was there — the bot itself knows nothing about profiles, which is why nothing can point a
        running service at the wrong file.
        <strong>@("phrases.json") and @("vocabulary.json") are shared</strong> and are not part of a
        profile.
    </div>
</div>

<div style="display:flex;align-items:center;justify-content:space-between;margin:16px 0 8px">
    <span style="font-size:10px;letter-spacing:1px;color:var(--faint)">SAVED PROFILES</span>
    @if (Store.ActiveProfile != null)
    {
        <span style="font-size:11px;color:@(Store.ActiveProfileStillMatches ? "var(--ok)" : "var(--accent)")">
            @(Store.ActiveProfileStillMatches
                ? $"Active: {Store.ActiveProfile}"
                : $"Active: {Store.ActiveProfile} — config.json has been edited since")
        </span>
    }
</div>

@{
    var profiles = Store.Profiles();
}

@if (profiles.Count == 0)
{
    <div class="card" style="color:var(--faint);font-size:12px">
        No profiles yet. Set the bot up the way you want it, then save it below under a name.
    </div>
}
else
{
    <table class="phrase-table">
        @foreach (var profile in profiles)
        {
            <tr>
                <td style="width:40%">
                    <span style="color:var(--text)">@profile.Name</span>
                    @if (string.Equals(profile.Name, Store.ActiveProfile, StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge" style="margin-left:8px">active</span>
                    }
                </td>
                <td style="color:var(--faint)">
                    @StartupPaths.Size(profile.Bytes), @StartupPaths.When(profile.LastWriteLocal)
                </td>
                <td style="width:190px;text-align:right">
                    @if (_confirmDelete == profile.Name)
                    {
                        <span style="color:var(--accent);font-size:11px">Delete it?</span>
                        <button class="icon-btn" style="color:var(--bad)" @onclick="() => Delete(profile.Name)">yes</button>
                        <button class="icon-btn" @onclick="() => _confirmDelete = null">no</button>
                    }
                    else
                    {
                        <button class="icon-btn" style="color:var(--teal)" @onclick="() => Activate(profile.Name)">activate</button>
                        <button class="icon-btn" @onclick="() => _confirmDelete = profile.Name">delete</button>
                    }
                </td>
            </tr>
        }
    </table>
}

<div class="card">
    <div class="card-head">
        <span style="font-size:10px;letter-spacing:1px;color:var(--faint)">SAVE THE SETTINGS ON SCREEN AS A PROFILE</span>
    </div>

    <div class="row2">
        <div class="field" style="margin:0">
            <label>NAME</label>
            <input type="text" @bind="_newName" @bind:event="oninput" placeholder="Training server" />
        </div>
        <div style="display:flex;align-items:flex-end">
            @if (_confirmOverwrite)
            {
                <span style="font-size:11px;color:var(--accent);margin-right:12px">
                    "@ConfigProfiles.Normalize(_newName)" exists. Replace it?
                </span>
                <button class="link-action" style="margin:0;color:var(--bad)" @onclick="() => Save(force: true)"><span>Replace</span></button>
                <button class="link-action" style="margin:0 0 0 12px" @onclick="() => _confirmOverwrite = false"><span>Cancel</span></button>
            }
            else
            {
                <button class="link-action" style="margin:0" @onclick="() => Save(force: false)"><span>Save as profile</span></button>
            }
        </div>
    </div>

    <div class="hint" style="margin-top:8px">
        Saves what is currently in this editor, including changes you have not written to
        <code>config.json</code> yet — trying something out and keeping it as a profile without
        touching the live settings is the usual reason to be here.
        @if (ConfigProfiles.NameProblem(_newName) is { } problem && _newName.Length > 0)
        {
            <div style="color:var(--accent);margin-top:6px">@problem</div>
        }
    </div>
</div>

<h1 class="section-title">BACKUP &amp; RESTORE</h1>

<div class="card">
    <div class="card-head">
        <span class="card-title">MAKE A BACKUP</span>
    </div>

    <div class="toggle-row">
        <span>Include the profiles <span class="quiet">(@profiles.Count in @ConfigProfiles.FolderName\)</span></span>
        <button class="toggle @(_withProfiles ? "on" : "")" @onclick="() => _withProfiles = !_withProfiles">
            <span class="knob"></span>
        </button>
    </div>

    <div class="toggle-row">
        <span>Leave out keys and passwords <span class="quiet">— for a copy you give to somebody else</span></span>
        <button class="toggle @(_withoutKeys ? "on" : "")" @onclick="() => _withoutKeys = !_withoutKeys">
            <span class="knob"></span>
        </button>
    </div>

    <div style="display:flex;align-items:center;gap:20px">
        <button class="link-action" style="margin:0" @onclick="BackUpHere"><span>Back up to the Backup folder</span></button>
        <button class="link-action" style="margin:0" @onclick="BackUpTo"><span>Back up to a file...</span></button>
    </div>

    <div class="hint" style="margin-top:10px">
        One ZIP file with <code>config.json</code>, <code>phrases.json</code>, <code>vocabulary.json</code>
        and, if switched on, the profiles — <strong>as they are on disk</strong>: changes in this
        editor that are not saved yet are not in it. The Backup folder is
        <code>@Store.BackupFolder</code>.
        @if (!_withoutKeys)
        {
            <span class="warn-text">
                With the keys in, the file holds the Gemini API key, the DCS-gRPC key, the Discord
                webhook and the AWACS password — keep it like a password.
            </span>
        }
        else
        {
            <span>
                Those four are blanked in the copy. Restoring it keeps the ones configured on the PC it
                is restored on.
            </span>
        }
    </div>
</div>

<div class="card">
    <div class="card-head">
        <span class="card-title">RESTORE</span>
        <span class="spacer"></span>
        <button class="link-action" style="margin:0" @onclick="RestoreFromFile"><span>Restore from a file...</span></button>
    </div>

    @if (_candidate != null)
    {
        <div class="confirm-box @(_candidateProblem != null ? "bad" : "")">
            @if (_candidateProblem != null)
            {
                <div class="bad-text">@(System.IO.Path.GetFileName(_candidate)) cannot be restored: @_candidateProblem</div>
                <button class="link-action" style="margin:8px 0 0" @onclick="CancelRestore"><span>Close</span></button>
            }
            else if (_candidateContents != null)
            {
                var manifest = _candidateContents.Manifest;
                <div style="font-size:12.5px">Restore <strong>@(System.IO.Path.GetFileName(_candidate))</strong>?</div>
                <div class="hint">
                    @if (manifest.Format > 0)
                    {
                        <span>Made @(manifest.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")) with build @(manifest.Build). </span>
                    }
                    else
                    {
                        <span>No backup note inside — a hand-made archive, so when it was made is unknown. </span>
                    }
                    Holds @(string.Join(", ", _candidateContents.Files))@(_candidateContents.Profiles.Count > 0
                        ? $" and {_candidateContents.Profiles.Count} profile(s): {string.Join(", ", _candidateContents.Profiles)}"
                        : ", no profiles").
                    @(manifest.SecretsRemoved
                        ? "Its keys were left out, so the keys configured now are kept."
                        : "Its keys replace the ones configured now.")
                    @if (_candidateContents.Ignored.Count > 0)
                    {
                        <span> Not restored, because they are not part of a backup: @(string.Join(", ", _candidateContents.Ignored.Take(5)))@(_candidateContents.Ignored.Count > 5 ? ", ..." : "").</span>
                    }
                </div>
                <div class="hint warn-text">
                    Replaces the files above; profiles not in the backup stay. Unsaved changes in this
                    editor are lost. What is there now is backed up first, as a <em>before restore</em> file.
                </div>
                <div style="display:flex;gap:16px;margin-top:10px">
                    <button class="link-action danger" style="margin:0" @onclick="ConfirmRestore"><span>Restore it</span></button>
                    <button class="link-action" style="margin:0" @onclick="CancelRestore"><span>Cancel</span></button>
                </div>
            }
        </div>
    }

    @{
        var backups = Store.Backups();
    }

    @if (backups.Count == 0)
    {
        <div class="hint">No backups in the Backup folder yet.</div>
    }
    else
    {
        <table class="phrase-table" style="margin:0">
            @foreach (var backup in backups)
            {
                <tr>
                    <td>
                        <span class="strong-text">@backup.Name</span>
                        @if (backup.BeforeRestore)
                        {
                            <span class="badge" style="margin-left:8px" title="Made automatically just before a restore - restoring it undoes that restore">before restore</span>
                        }
                    </td>
                    <td class="quiet" style="width:170px">
                        @StartupPaths.Size(backup.Bytes), @StartupPaths.When(backup.LastWriteLocal)
                    </td>
                    <td style="width:90px;text-align:right">
                        <button class="icon-btn accent" @onclick="() => Consider(backup.FullPath)">restore...</button>
                    </td>
                </tr>
            }
        </table>
    }

    <div class="hint" style="margin-top:10px">
        A restore checks every file in the backup the way the bot reads it before it changes anything,
        and backs up the current state first — restoring that <em>before restore</em> file undoes it.
        Restart the bot afterwards for the restored settings to take effect.
    </div>
</div>

@code {

    /// <summary>
    /// Picks the folder, but does not switch to it - "Use this folder and load" still has to be
    /// pressed. Browsing is how you find a folder; loading it is a decision, and it reloads
    /// everything on screen.
    /// </summary>
    private void BrowseFolder()
    {
        var picked = Picker.PickFolder("Select the folder holding the bot's config.json", _folder);
        if (picked != null) _folder = picked;
    }

    private string _folder = "";
    private string _newName = "";

    /// <summary>
    /// Which row is asking "delete it?", and whether the save button is asking about an
    /// overwrite. Both are two-step rather than a dialog: this editor has no JavaScript interop,
    /// and a profile is the only copy of a setup somebody arranged by hand.
    /// </summary>
    private string? _confirmDelete;

    private bool _confirmOverwrite;

    protected override void OnInitialized()
    {
        Store.OnChange += StateHasChanged;
        _folder = Store.ConfigFolder;
    }

    private void ApplyFolder()
    {
        _confirmDelete = null;
        _confirmOverwrite = false;
        Store.UseFolder(_folder);

        // Whatever the store settled on - the typed path, or the old one if it was refused.
        _folder = Store.ConfigFolder;
    }

    private void Save(bool force)
    {
        if (ConfigProfiles.NameProblem(_newName) != null)
        {
            // Let the store do the complaining, so the message lands in the footer like every
            // other one rather than only in the hint under the field.
            Store.SaveProfile(_newName);
            return;
        }

        if (!force && ConfigProfiles.Exists(Store.ConfigFolder, _newName))
        {
            _confirmOverwrite = true;
            return;
        }

        Store.SaveProfile(_newName);
        _confirmOverwrite = false;
        _newName = "";
    }

    private void Activate(string name)
    {
        _confirmDelete = null;
        Store.ActivateProfile(name);
        _folder = Store.ConfigFolder;
    }

    private void Delete(string name)
    {
        _confirmDelete = null;
        Store.DeleteProfile(name);
    }

    // --- backup and restore ------------------------------------------------------------------

    private bool _withProfiles = true;
    private bool _withoutKeys;

    /// <summary>
    /// The backup the "restore it?" box is asking about, what it holds, and why it cannot be
    /// restored when it cannot. Two-step for the same reason as deleting a profile: a restore
    /// replaces the live settings, and this editor has no dialogs of its own.
    /// </summary>
    private string? _candidate;
    private BackupContents? _candidateContents;
    private string? _candidateProblem;

    private void BackUpHere()
    {
        CancelRestore();
        Store.CreateBackup(_withProfiles, _withoutKeys);
    }

    private void BackUpTo()
    {
        CancelRestore();

        var picked = Picker.PickSaveFile("Where should the backup go?", Store.BackupFolder,
            ConfigBackup.FileNameFor(DateTime.Now), IPathPicker.Filters.Backups);

        if (picked != null) Store.CreateBackup(_withProfiles, _withoutKeys, picked);
    }

    private void RestoreFromFile()
    {
        var picked = Picker.PickFile("Pick a Darkstar backup to restore", Store.BackupFolder,
            IPathPicker.Filters.Backups);

        if (picked != null) Consider(picked);
    }

    /// <summary>Reads and checks a backup and asks about it - nothing is restored yet.</summary>
    private void Consider(string path)
    {
        _candidate = path;
        _candidateContents = Store.InspectBackup(path, out _candidateProblem);
    }

    private void CancelRestore()
    {
        _candidate = null;
        _candidateContents = null;
        _candidateProblem = null;
    }

    private void ConfirmRestore()
    {
        if (_candidate == null || _candidateContents == null) return;

        var path = _candidate;
        CancelRestore();
        _confirmDelete = null;
        _confirmOverwrite = false;

        Store.RestoreBackup(path);

        // The restore reloads everything; the folder field shows whatever the store settled on.
        _folder = Store.ConfigFolder;
    }

    public void Dispose() => Store.OnChange -= StateHasChanged;
}
