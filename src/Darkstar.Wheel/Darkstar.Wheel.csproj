<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The radio wheel: a small tray program for the PLAYER's PC. It draws a wheel of the bot's calls
    over DCS, and a pick becomes a line in the DCS chat that the server hands to Darkstar. Nothing in
    here talks to SRS, DCS-gRPC or the server - the client hook dcs\Scripts\Hooks\Darkstar-Wheel.lua
    does the sending, inside DCS.

    Windows Forms rather than WPF: one borderless, click-through, never-focused window drawn with
    GDI+, which is exactly what a layered window is and what WPF makes awkward. It is also small
    enough to hand to a squadron as one small setup: installer\Wheel.iss, built by
    build-installer.ps1 next to the server installer.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Darkstar.Wheel</RootNamespace>
    <AssemblyName>Darkstar.Wheel</AssemblyName>
    <AssemblyTitle>D.A.R.K.S.T.A.R. Radio Wheel</AssemblyTitle>
    <ApplicationIcon>..\Darkstar.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Like the bot and the editor: installer\Wheel.iss packs the publish folder wholesale, so the
         XML API docs of referenced packages stay behind and only the symbols may travel along. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <Version>0.0.0</Version>
    <InformationalVersion>0.0.0-dev</InformationalVersion>
    <!-- The .NET 8 SDK appends the git commit ("+<sha>") to InformationalVersion in a git
         checkout. build-installer.ps1 compares the stamp it passed with the one it finds in
         the published file, so an appended hash failed every build made from a clone. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Darkstar.Core\Darkstar.Core.csproj" />
  </ItemGroup>

  <!-- The client hook travels with the wheel, so a player has both halves in one folder. -->
  <ItemGroup>
    <None Include="..\..\dcs\Scripts\Hooks\Darkstar-Wheel.lua"
          Link="dcs\Scripts\Hooks\Darkstar-Wheel.lua"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
